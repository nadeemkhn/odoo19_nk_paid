<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. Server Action -->
        <record id="action_sync_shopify_return" model="ir.actions.server">
            <field name="name">Sync Shopify Return(s)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">records.action_sync_shopify_return()</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">action</field>
        </record>

        <record id="action_bulk_export_products_shopify" model="ir.actions.server">
            <field name="name">Export Products to Shopify</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">records.action_bulk_export_to_shopify()</field>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_type">action</field>
        </record>

        <record id="action_bulk_import_shopify_stock" model="ir.actions.server">
            <field name="name">Import Stock from Shopify</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">records.action_import_shopify_stock()</field>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_type">action</field>
        </record>

        <record id="action_bulk_import_shopify_stock_template" model="ir.actions.server">
            <field name="name">Import Stock from Shopify</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">records.action_bulk_import_shopify_stock_template()</field>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_type">action</field>
        </record>


    </data>
</odoo>
