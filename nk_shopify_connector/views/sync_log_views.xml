<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_shopify_sync_log_list" model="ir.ui.view">
            <field name="name">shopify.sync.log.list</field>
            <field name="model">shopify.sync.log</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" edit="false"
                      decoration-success="status == 'success'"
                      decoration-danger="status == 'failed'"
                      decoration-warning="status == 'warning'">
                    <field name="create_date"/>
                    <field name="instance_id"/>
                    <field name="channel"/>
                    <field name="operation"/>
                    <field name="status"/>
                    <field name="model_name"/>
                    <field name="reference"/>
                    <field name="duration_ms"/>
                    <field name="message"/>
                </list>
            </field>
        </record>

        <record id="view_shopify_sync_log_form" model="ir.ui.view">
            <field name="name">shopify.sync.log.form</field>
            <field name="model">shopify.sync.log</field>
            <field name="arch" type="xml">
                <form create="false" delete="false" edit="false" string="Shopify Sync Log">
                    <sheet>
                        <group>
                            <group>
                                <field name="create_date"/>
                                <field name="instance_id"/>
                                <field name="user_id"/>
                                <field name="channel"/>
                                <field name="operation"/>
                            </group>
                            <group>
                                <field name="status"/>
                                <field name="level"/>
                                <field name="model_name"/>
                                <field name="res_id"/>
                                <field name="reference"/>
                                <field name="duration_ms"/>
                            </group>
                        </group>
                        <group>
                            <field name="message"/>
                            <field name="payload" widget="text"/>
                            <field name="response" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_shopify_sync_log_search" model="ir.ui.view">
            <field name="name">shopify.sync.log.search</field>
            <field name="model">shopify.sync.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="operation"/>
                    <field name="reference"/>
                    <field name="model_name"/>
                    <field name="instance_id"/>
                    <filter name="filter_success" string="Success" domain="[('status', '=', 'success')]"/>
                    <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                    <filter name="filter_warning" string="Warning" domain="[('status', '=', 'warning')]"/>
                    <filter name="filter_today" string="Today" domain="[('create_date', '&gt;=', 'today')]"/>
                    <separator/>
                    <group>
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                        <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                        <filter name="group_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_shopify_sync_logs" model="ir.actions.act_window">
            <field name="name">Sync Logs</field>
            <field name="res_model">shopify.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_shopify_sync_log_search"/>
            <field name="context">{'search_default_filter_today': 1}</field>
        </record>

        <record id="action_shopify_connector_orders" model="ir.actions.act_window">
            <field name="name">Shopify Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('shopify_order_id', '!=', False)]</field>
        </record>

        <record id="view_shopify_connector_customer_list" model="ir.ui.view">
            <field name="name">shopify.connector.customer.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Shopify Customers">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="shopify_instance_id"/>
                    <field name="country_id"/>
                    <field name="shopify_customer_id"/>
                </list>
            </field>
        </record>

        <record id="action_shopify_connector_customers" model="ir.actions.act_window">
            <field name="name">Shopify Customers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_shopify_connector_customer_list"/>
            <field name="domain">[('shopify_customer_id', '!=', False)]</field>
        </record>

        <record id="view_shopify_connector_product_list" model="ir.ui.view">
            <field name="name">shopify.connector.product.list</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <list string="Shopify Products">
                    <field name="name"/>
                    <field name="default_code"/>
                    <field name="shopify_instance_id"/>
                    <field name="shopify_product_id"/>
                    <field name="list_price"/>
                </list>
            </field>
        </record>

        <record id="action_shopify_connector_products" model="ir.actions.act_window">
            <field name="name">Shopify Products</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_shopify_connector_product_list"/>
            <field name="domain">[('shopify_instance_id', '!=', False)]</field>
        </record>

        <record id="action_shopify_connector_invoices" model="ir.actions.act_window">
            <field name="name">Shopify Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('shopify_order_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        </record>

        <record id="action_shopify_connector_refunds" model="ir.actions.act_window">
            <field name="name">Shopify Refunds</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('shopify_order_id', '!=', False), ('move_type', '=', 'out_refund')]</field>
        </record>

        <record id="action_shopify_connector_pickings" model="ir.actions.act_window">
            <field name="name">Shopify Deliveries/Returns</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('shopify_order_id', '!=', False)]</field>
        </record>

        <menuitem id="menu_shopify_connector_data_root"
                  name="Connector Data"
                  parent="menu_shopify_order_import_root"
                  sequence="13"/>

        <menuitem id="menu_shopify_connector_orders"
                  name="Orders"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_orders"
                  sequence="10"/>

        <menuitem id="menu_shopify_connector_customers"
                  name="Customers"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_customers"
                  sequence="20"/>

        <menuitem id="menu_shopify_connector_products"
                  name="Products"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_products"
                  sequence="30"/>

        <menuitem id="menu_shopify_connector_invoices"
                  name="Invoices"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_invoices"
                  sequence="40"/>

        <menuitem id="menu_shopify_connector_refunds"
                  name="Refunds"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_refunds"
                  sequence="45"/>

        <menuitem id="menu_shopify_connector_pickings"
                  name="Deliveries/Returns"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_connector_pickings"
                  sequence="50"/>

        <menuitem id="menu_shopify_connector_import_queue"
                  name="Imported Queue"
                  parent="menu_shopify_connector_data_root"
                  action="action_shopify_order_import"
                  sequence="60"/>

        <menuitem id="menu_shopify_dashboard_summary"
                  name="Dashboard"
                  parent="menu_shopify_order_import_root"
                  action="action_shopify_multi_store_dashboard"
                  sequence="5"/>

        <menuitem id="menu_shopify_sync_logs"
                  name="Sync Logs"
                  parent="menu_shopify_order_import_root"
                  action="action_shopify_sync_logs"
                  sequence="14"/>
    </data>
</odoo>
