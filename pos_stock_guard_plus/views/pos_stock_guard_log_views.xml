<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_stock_guard_log_tree" model="ir.ui.view">
        <field name="name">pos.stock.guard.log.tree</field>
        <field name="model">pos.stock.guard.log</field>
        <field name="arch" type="xml">
            <list string="POS Stock Guard Logs" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="action"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="product_id"/>
                <field name="stock_basis"/>
                <field name="available_qty"/>
                <field name="required_qty"/>
                <field name="allowed_qty"/>
            </list>
        </field>
    </record>

    <record id="view_pos_stock_guard_log_form" model="ir.ui.view">
        <field name="name">pos.stock.guard.log.form</field>
        <field name="model">pos.stock.guard.log</field>
        <field name="arch" type="xml">
            <form string="POS Stock Guard Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="action"/>
                            <field name="user_id"/>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="product_id"/>
                            <field name="stock_basis"/>
                        </group>
                        <group>
                            <field name="available_qty"/>
                            <field name="reserve_qty"/>
                            <field name="order_qty"/>
                            <field name="add_qty"/>
                            <field name="required_qty"/>
                            <field name="allowed_qty"/>
                        </group>
                    </group>
                    <group>
                        <field name="detail" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_stock_guard_log_search" model="ir.ui.view">
        <field name="name">pos.stock.guard.log.search</field>
        <field name="model">pos.stock.guard.log</field>
        <field name="arch" type="xml">
            <search string="POS Stock Guard Logs">
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="product_id"/>
                <field name="action"/>
                <filter string="Blocked" name="blocked" domain="[('action', '=', 'block')]"/>
                <filter string="Warnings" name="warnings" domain="[('action', '=', 'warn')]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_stock_guard_log" model="ir.actions.act_window">
        <field name="name">Stock Guard Logs</field>
        <field name="res_model">pos.stock.guard.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_stock_guard_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock guard records yet.</p>
            <p>Logs are created when cashier attempts exceed stock limits.</p>
        </field>
    </record>

    <menuitem
        id="menu_pos_stock_guard_log"
        name="Stock Guard Logs"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_stock_guard_log"
        groups="point_of_sale.group_pos_manager"
        sequence="90"/>
</odoo>
