        <record id="ir_cron_push_products_to_shopify" model="ir.cron">
            <field name="name">Export Products to Shopify (Manual Trigger Only)</field>
            <field name="model_id" ref="model_shopify_product_export"/>
            <field name="state">code</field>
            <field name="code">model.push_products_to_shopify()</field>
            <field name="interval_number">6</field> <!-- Runs every interval -->
            <field name="interval_type">minutes</field> <!-- minutes, hours, days, etc -->
            <field name="active">False</field>
        </record>

        <record id="ir_cron_import_products_from_shopify" model="ir.cron">
            <field name="name">Import Products from Shopify</field>
            <field name="model_id" ref="model_shopify_product_importer"/>
            <field name="state">code</field>
            <field name="code">model.cron_import_products_from_shopify()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_import_customers_from_shopify" model="ir.cron">
            <field name="name">Import Customers from Shopify</field>
            <field name="model_id" ref="model_shopify_customer_importer"/>
            <field name="state">code</field>
            <field name="code">model.cron_import_customers_from_shopify()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>


