        <record id="ir_cron_export_shopify_stock" model="ir.cron">
            <field name="name">Export Shopify Stock Every 2 Minutes</field>
            <field name="model_id" ref="model_shopify_stock_export"/>
            <field name="state">code</field>
            <field name="code">model.export_stock_to_shopify()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_push_payments_to_shopify" model="ir.cron">
            <field name="name">Push Paid Invoices to Shopify</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cron_push_payments_to_shopify()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>


