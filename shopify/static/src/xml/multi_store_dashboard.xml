<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="shopify.MultiStoreDashboard">
        <div class="o_shopify_multi_dashboard p-3 p-md-4">
            <div class="o_shopify_dashboard_top d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="m-0">Shopify Multi-Store Dashboard</h2>
                    <p class="o_shopify_dashboard_subtitle m-0">Monitor all connected stores in one place</p>
                </div>
                <button class="btn o_shopify_refresh_btn" t-on-click="loadDashboard">Refresh</button>
            </div>

            <t t-if="state.loading">
                <div class="alert alert-info o_shopify_loading_alert">Loading store data...</div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-danger" t-esc="state.error"/>
            </t>
            <t t-else="">
                <div class="o_shopify_store_grid">
                    <t t-foreach="state.stores" t-as="store" t-key="store.id">
                        <div class="o_shopify_store_card">
                            <div class="o_shopify_store_header">
                                <div class="o_shopify_store_identity">
                                    <h4 class="m-0" t-esc="store.name"/>
                                    <div class="text-muted" t-esc="store.domain"/>
                                </div>
                                <span class="badge o_shopify_state_badge" t-esc="store.state"/>
                            </div>
                            <div class="o_shopify_last_sync mb-3">
                                Last Sync: <t t-esc="formatDate(store.last_sync)"/>
                            </div>

                            <div class="o_shopify_store_stats">
                                <div class="stat">
                                    <span class="label">Orders</span>
                                    <span class="value" t-esc="store.orders_count"/>
                                </div>
                                <div class="stat">
                                    <span class="label">Products</span>
                                    <span class="value" t-esc="store.products_count"/>
                                </div>
                                <div class="stat">
                                    <span class="label">Customers</span>
                                    <span class="value" t-esc="store.customers_count"/>
                                </div>
                                <div class="stat stat_sales">
                                    <span class="label">Sales</span>
                                    <span class="value" t-esc="formatCurrency(store.sales_amount)"/>
                                </div>
                            </div>

                            <div class="o_shopify_store_actions mt-3">
                                <button class="btn btn-outline-primary btn-sm" t-on-click="openOrders.bind(this, store)">Orders</button>
                                <button class="btn btn-outline-primary btn-sm" t-on-click="openProducts.bind(this, store)">Products</button>
                                <button class="btn btn-outline-primary btn-sm" t-on-click="openCustomers.bind(this, store)">Customers</button>
                                <button class="btn btn-outline-secondary btn-sm" t-on-click="openLogs.bind(this, store)">Logs</button>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
