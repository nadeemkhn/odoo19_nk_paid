<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_shopify_dashboard_tree" model="ir.ui.view">
            <field name="name">shopify.dashboard.tree</field>
            <field name="model">shopify.dashboard</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" edit="false">
                    <field name="total_orders"/>
                    <field name="total_amount"/>
                    <field name="paid_orders"/>
                    <field name="partial_orders"/>
                    <field name="unpaid_orders"/>
                    <button name="action_open_shopify_orders"
                            type="object"
                            icon="fa-external-link"
                            string="View Orders"/>
                </list>
            </field>
        </record>


        <!-- Kanban View -->
        <record id="view_shopify_dashboard_kanban" model="ir.ui.view">
            <field name="name">shopify.dashboard.kanban</field>
            <field name="model">shopify.dashboard</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record">
                                <div class="p-2">
                                    <h4>Shopify Summary</h4>
                                    <div>Total Orders:
                                        <field name="total_orders"/>
                                    </div>
                                    <div>Total Amount:
                                        <field name="total_amount"/>
                                    </div>
                                    <div>Paid Orders:
                                        <field name="paid_orders"/>
                                    </div>
                                    <div>Partial Orders:
                                        <field name="partial_orders"/>
                                    </div>
                                    <div>Unpaid
                                        <field name="unpaid_orders"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_shopify_dashboard_pivot" model="ir.ui.view">
            <field name="name">shopify.dashboard.pivot</field>
            <field name="model">shopify.dashboard</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="total_orders" type="measure"/>
                    <field name="total_amount" type="measure"/>
                    <field name="paid_orders" type="measure"/>
                    <field name="partial_orders" type="measure"/>
                    <field name="unpaid_orders" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_shopify_dashboard_graph" model="ir.ui.view">
            <field name="name">shopify.dashboard.graph</field>
            <field name="model">shopify.dashboard</field>
            <field name="arch" type="xml">
                <graph string="Shopify Overview" type="bar">
                    <field name="total_orders" type="measure"/>
                    <field name="paid_orders" type="measure"/>
                    <field name="partial_orders" type="measure"/>
                    <field name="unpaid_orders" type="measure"/>
                </graph>
            </field>
        </record>



        <!-- Search View -->
        <record id="view_shopify_dashboard_search" model="ir.ui.view">
            <field name="name">shopify.dashboard.search</field>
            <field name="model">shopify.dashboard</field>
            <field name="arch" type="xml">
                <search>
                    <field name="total_orders"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_shopify_dashboard" model="ir.actions.act_window">
            <field name="name">Shopify Summary</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shopify.dashboard</field>
            <field name="view_mode">list,kanban,pivot,graph,form</field>
            <field name="search_view_id" ref="view_shopify_dashboard_search"/>
        </record>

        <record id="action_shopify_multi_store_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">shopify_multi_store_dashboard</field>
        </record>

        <!-- Menu -->
<!--        <menuitem id="menu_shopify_dashboard_summary"-->
<!--                  name="Shopify Summary"-->
<!--                  parent="menu_shopify_order_import_root"-->
<!--                  action="action_shopify_dashboard"-->
<!--                  sequence="20"/>-->

    </data>
</odoo>
