<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_form_inherit_shopify_import_stock" model="ir.ui.view">
            <field name="name">product.product.form.inherit.shopify</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_import_shopify_stock"
                            type="object"
                            string="Import Shopify Stock"
                            class="oe_stat_button"/>
                </xpath>
            </field>
        </record>
        <!-- views/product_views.xml -->

        <record id="view_product_form_inherit_shopify_fields" model="ir.ui.view">
            <field name="name">product.product.form.inherit.shopify</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="shopify_instance_id"/>
                    <field name="shopify_product_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_form_inherit_shopify" model="ir.ui.view">
            <field name="name">product.template.form.inherit.shopify</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_export_to_shopify"
                            type="object"
                            string="Export to Shopify"
                            class="oe_stat_button"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="shopify_instance_id"/>
                    <field name="shopify_product_id"  invisible="1"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
