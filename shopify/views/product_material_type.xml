<odoo>
    <data>

        <!--INHERITED PRODUCT TEMPLATE FOR THE FOLLOWING FIELD-->
        <record id="view_product_inherit_material_form" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tag_ids']" position="after">
                    <field name="material_type_id"/>
                </xpath>
            </field>
        </record>

        <!--PRODUCT MATERIAL VIEWS-->
        <record id="view_product_material_type_form" model="ir.ui.view">
            <field name="name">product.material.type.form</field>
            <field name="model">product.material.type</field>
            <field name="arch" type="xml">
                <form string="Product Material Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <notebook>
                            <page string="Product Material Type"></page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_product_material_type_tree" model="ir.ui.view">
            <field name="name">product.material.type.tree</field>
            <field name="model">product.material.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="action_product_material_type" model="ir.actions.act_window">
            <field name="name">Product Material Type</field>
            <field name="res_model">product.material.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_product_material_type"
                  name="Product Material Type"
                  parent="stock.menu_stock_config_settings"
                  action="action_product_material_type"
                  sequence="5"/>


        <!--PURCHASE FIELDS-->
        <record id="view_purchase_order_form_inherit_price" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.price.fields</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="after">
                    <field name="accessory"/>
                    <field name="other_charges"/>
                    <!--                <field name="total_price" readonly="1"/>-->
                </xpath>


            </field>
        </record>


    </data>
</odoo>
