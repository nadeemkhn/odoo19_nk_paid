<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Diagnostics Form View -->
    <record id="view_shopify_diagnostics_form" model="ir.ui.view">
        <field name="name">shopify.diagnostics.form</field>
        <field name="model">shopify.diagnostics</field>
        <field name="arch" type="xml">
            <form string="Shopify Integration Diagnostics">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="result" widget="html" nolabel="1" options="{'style-inline': true}"/>
                        </h1>
                    </div>
                </sheet>
                <footer>
                    <button string="🔄 Re-Run Diagnostics" name="run_diagnostics" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Diagnostics Action -->
    <record id="action_shopify_diagnostics" model="ir.actions.act_window">
        <field name="name">Shopify Integration Diagnostics</field>
        <field name="res_model">shopify.diagnostics</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_shopify_diagnostics"
              name="Run Diagnostics"
              parent="menu_shopify_order_import_root"
              action="action_shopify_diagnostics"
              sequence="12"/>
</odoo>
