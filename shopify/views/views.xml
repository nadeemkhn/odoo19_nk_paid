        <record id="view_move_form_inherit_shopify" model="ir.ui.view">
            <field name="name">account.move.form.inherit.shopify</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="shopify_order_id" readonly="1" invisible="1"/>
                    <field name="delivery_partner_id" readonly="1"/>
                    <field name="tracking_number" readonly="1"/>
                </xpath>
            </field>
        </record>


        <!-- Shopify Order Import Form View -->
        <record id="view_shopify_order_import_form" model="ir.ui.view">
            <field name="name">shopify.order.import.form</field>
            <field name="model">shopify.order.import</field>
            <field name="arch" type="xml">
                <form string="Shopify Order Import">
                    <header>
                        <button name="import_shopify_orders" type="object" string="Import Orders"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="shopify_instance_id"/>
                            <field name="customer_name"/>
                            <field name="shopify_order_id"/>
                            <field name="payment_status"/>
                            <field name="fulfillment_status"/>
                            <field name="tracking"/>
                            <field name="courier"/>
                            <field name="total_amount"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Shopify Order Import Tree View -->
        <record id="view_shopify_order_import_tree" model="ir.ui.view">
            <field name="name">shopify.order.import.tree</field>
            <field name="model">shopify.order.import</field>
            <field name="arch" type="xml">
                <list string="Shopify Orders">
                    <field name="name"/>
                    <field name="shopify_instance_id"/>
                    <field name="customer_name"/>
                    <field name="payment_status"/>
                    <field name="fulfillment_status"/>
                    <field name="last_import_date"/>
                    <field name="tracking"/>
                    <field name="courier"/>

                    <field name="shopify_order_id"/>
                    <field name="total_amount"/>
                </list>
            </field>
        </record>

        <!-- Menu Items -->

        <record id="action_shopify_order_import" model="ir.actions.act_window">
            <field name="name">Shopify Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shopify.order.import</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_shopify_order_import_root"
                  web_icon="shopify,static/description/icon.png"
                  name="Shopify Connector"
                  sequence="10"/>

