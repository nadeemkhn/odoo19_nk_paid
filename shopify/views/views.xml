        <record id="view_order_tree_custom_shopify" model="ir.ui.view">
            <field name="name">sale.order.tree.custom.shopify</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="default_order">origin desc</attribute>
                </xpath>
            </field>
        </record>

