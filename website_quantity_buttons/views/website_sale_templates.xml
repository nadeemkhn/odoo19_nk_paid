<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="website_sale_products_item_qty_buttons"
        inherit_id="website_sale.products_item"
        name="Website Quantity Buttons on Product Card"
    >
        <xpath expr="//div[hasclass('o_wsale_product_sub')]/div[hasclass('o_wsale_product_btn')]" position="before">
            <t t-set="qty_button_values" t-value="product.website_get_qty_button_values()"/>
            <t t-set="qty_button_label" t-value="product.website_get_qty_button_label()"/>
            <div
                t-if="qty_button_values"
                class="o_qty_button_group o_qty_button_group_card mb-2"
                t-att-data-default-qty="qty_button_values[0]"
            >
                <input
                    type="hidden"
                    name="add_qty"
                    class="o_qty_button_input"
                    t-att-value="qty_button_values[0]"
                />
                <t t-foreach="qty_button_values" t-as="qty_value">
                    <button
                        type="button"
                        t-attf-class="btn btn-sm o_qty_choice {{'active o_qty_default' if qty_value_index == 0 else ''}}"
                        t-att-data-qty="qty_value"
                        t-att-aria-pressed="'true' if qty_value_index == 0 else 'false'"
                    >
                        <t t-esc="str(qty_value) + '-' + qty_button_label"/>
                        <span class="o_qty_discount_badge d-none"/>
                    </button>
                </t>
            </div>
            <div t-if="qty_button_values" class="o_qty_savings_text d-none" aria-live="polite"/>
        </xpath>
    </template>

    <template
        id="website_sale_dynamic_filter_qty_buttons"
        inherit_id="website_sale.dynamic_filter_template_product_product_products_item"
        name="Website Quantity Buttons on Dynamic Product Card"
    >
        <xpath expr="//div[hasclass('o_wsale_product_sub')]/div[hasclass('o_wsale_product_btn')]" position="before">
            <t t-set="qty_button_values" t-value="product.website_get_qty_button_values()"/>
            <t t-set="qty_button_label" t-value="product.website_get_qty_button_label()"/>
            <div
                t-if="qty_button_values"
                class="o_qty_button_group o_qty_button_group_card mb-2"
                t-att-data-default-qty="qty_button_values[0]"
            >
                <t t-foreach="qty_button_values" t-as="qty_value">
                    <button
                        type="button"
                        t-attf-class="btn btn-sm o_qty_choice {{'active o_qty_default' if qty_value_index == 0 else ''}}"
                        t-att-data-qty="qty_value"
                        t-att-aria-pressed="'true' if qty_value_index == 0 else 'false'"
                    >
                        <t t-esc="str(qty_value) + '-' + qty_button_label"/>
                        <span class="o_qty_discount_badge d-none"/>
                    </button>
                </t>
            </div>
            <div t-if="qty_button_values" class="o_qty_savings_text d-none" aria-live="polite"/>
        </xpath>
    </template>

    <template
        id="website_sale_product_qty_buttons"
        inherit_id="website_sale.product"
        name="Website Quantity Buttons on Product Detail"
    >
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="before">
            <t t-set="qty_button_values" t-value="product.website_get_qty_button_values()"/>
            <t t-set="qty_button_label" t-value="product.website_get_qty_button_label()"/>
            <div
                t-if="qty_button_values"
                class="o_qty_button_group o_qty_button_group_detail mb-3"
                t-att-data-default-qty="qty_button_values[0]"
            >
                <input
                    t-if="not is_view_active('website_sale.product_quantity')"
                    type="hidden"
                    name="add_qty"
                    class="o_qty_button_input"
                    t-att-value="qty_button_values[0]"
                />
                <t t-foreach="qty_button_values" t-as="qty_value">
                    <button
                        type="button"
                        t-attf-class="btn btn-sm o_qty_choice {{'active o_qty_default' if qty_value_index == 0 else ''}}"
                        t-att-data-qty="qty_value"
                        t-att-aria-pressed="'true' if qty_value_index == 0 else 'false'"
                    >
                        <t t-esc="str(qty_value) + '-' + qty_button_label"/>
                        <span class="o_qty_discount_badge d-none"/>
                    </button>
                </t>
            </div>
            <div t-if="qty_button_values" class="o_qty_savings_text d-none" aria-live="polite"/>
        </xpath>
    </template>
</odoo>
