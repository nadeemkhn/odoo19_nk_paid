<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_form_view_qty_buttons" model="ir.ui.view">
        <field name="name">website.form.qty.buttons</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Quantity Buttons" name="qty_buttons_page">
                    <group>
                        <field name="website_qty_button_enabled"/>
                        <field
                            name="website_qty_button_values"
                            placeholder="1,2,3"
                            invisible="not website_qty_button_enabled"
                        />
                        <field
                            name="website_qty_button_label"
                            placeholder="Pack"
                            invisible="not website_qty_button_enabled"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
